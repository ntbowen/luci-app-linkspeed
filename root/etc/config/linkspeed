config linkspeed 'config'
	list cn_url 'https://mirrors.bfsu.edu.cn/ubuntu-releases/24.04.4/ubuntu-24.04.4-desktop-amd64.iso'
	list cn_url 'https://mirrors.nju.edu.cn/ubuntu-releases/24.04/ubuntu-24.04.4-desktop-amd64.iso'
	list cn_url 'https://mirrors.tuna.tsinghua.edu.cn/ubuntu-releases/24.04.4/ubuntu-24.04.4-desktop-amd64.iso'
	list cn_url 'https://mirror.sjtu.edu.cn/ubuntu-releases/24.04.4/ubuntu-24.04.4-desktop-amd64.iso'
	list cn_url 'https://mirrors.hit.edu.cn/ubuntu-releases/24.04.4/ubuntu-24.04.4-desktop-amd64.iso'
	list global_url 'https://speed.cloudflare.com/__down?bytes=100000000'
	list global_url 'https://proof.ovh.net/files/1Gb.dat'
	list global_url 'https://speed.hetzner.de/1GB.bin'
	list global_url 'https://download.thinkbroadband.com/1GB.zip'
	list global_url 'https://speedtest.tele2.net/1GB.zip'
	# option wan_device 'wwan0'  # override auto-detected WAN device used for live counters
	option cn_upload_url 'https://test.nju.edu.cn/backend/empty.php'
	option global_upload_url 'https://speed.cloudflare.com/__up'
	option duration '15'
	option max_megabytes '1000'
	option history_limit '20'
