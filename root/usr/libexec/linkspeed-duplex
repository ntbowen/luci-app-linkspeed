#!/bin/sh

duration="$1"
max_mb="$2"
upload_url="$3"
shift 3

tmpdir="/tmp/linkspeed-duplex.$$"
pidfile="/var/run/linkspeed-test.pids"
mkdir -p "$tmpdir" || exit 1
: > "$pidfile"
export LINKSPEED_PIDFILE="$pidfile"
export LINKSPEED_SHARED=1
export LINKSPEED_PARENT_SHARED=1
trap 'rm -rf "$tmpdir"; rm -f "$pidfile"' EXIT INT TERM

/usr/libexec/linkspeed-test-multi "$duration" "$max_mb" "$@" >"$tmpdir/down" 2>"$tmpdir/down.err" &
/usr/libexec/linkspeed-upload-multi "$duration" "$max_mb" "$upload_url" 3 >"$tmpdir/up" 2>"$tmpdir/up.err" &
wait

sed 's/^/D|/' "$tmpdir/down"
sed 's/^/U|/' "$tmpdir/up"
