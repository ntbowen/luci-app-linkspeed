#!/bin/sh

duration="${1:-15}"
max_total_mb="${2:-100}"
shift 2

count=$#
[ "$count" -ge 2 ] && [ "$count" -le 10 ] || {
	echo 'Concurrent test requires 2-10 URLs' >&2
	exit 2
}

case "$max_total_mb" in
	''|*[!0-9]*) echo 'Max download size must be an integer' >&2; exit 2 ;;
esac

# Split the total cap evenly across connections, rounding up to avoid 0 MB.
per_mb=$(( (max_total_mb + count - 1) / count ))
tmpdir="/tmp/linkspeed-multi.$$"
pidfile="${LINKSPEED_PIDFILE:-/var/run/linkspeed-test.pids}"
mkdir -p "$tmpdir" || exit 1
[ "${LINKSPEED_SHARED:-0}" = "1" ] || : > "$pidfile"
export LINKSPEED_PIDFILE="$pidfile"
export LINKSPEED_SHARED=1
cleanup() {
	rm -rf "$tmpdir"
	[ "${LINKSPEED_PARENT_SHARED:-0}" = "1" ] || rm -f "$pidfile"
}
trap cleanup EXIT INT TERM

i=0
for url in "$@"; do
	i=$((i + 1))
	/usr/libexec/linkspeed-test "$url" "$duration" "$per_mb" \
		>"$tmpdir/$i.out" 2>"$tmpdir/$i.err" &
done

wait

i=0
while [ "$i" -lt "$count" ]; do
	i=$((i + 1))
	if [ -s "$tmpdir/$i.out" ]; then
		cat "$tmpdir/$i.out"
	else
		printf '%s\n' '0||0|0|0|0|0|0'
	fi
done
