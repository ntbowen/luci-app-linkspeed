#!/bin/sh

url="$1"
duration="${2:-15}"
max_mb="${3:-100}"

case "$url" in
	http://*|https://*) ;;
	*) echo 'Test URL must start with http:// or https://' >&2; exit 2 ;;
esac

case "$duration" in
	''|*[!0-9]*) echo 'Duration must be an integer' >&2; exit 2 ;;
esac
case "$max_mb" in
	''|*[!0-9]*) echo 'Max download size must be an integer' >&2; exit 2 ;;
esac

[ "$duration" -ge 3 ] && [ "$duration" -le 86400 ] || {
	echo 'Duration must be between 3 and 86400 seconds' >&2
	exit 2
}
[ "$max_mb" -ge 0 ] || {
	echo 'Max download size must be greater than or equal to 0 MB' >&2
	exit 2
}

range_arg=""
[ "$max_mb" -gt 0 ] && range_arg="--range 0-$((max_mb * 1024 * 1024 - 1))"
pidfile="${LINKSPEED_PIDFILE:-/var/run/linkspeed-test.pids}"
tmpbase="/tmp/linkspeed-test.$$"
[ "${LINKSPEED_SHARED:-0}" = "1" ] || : > "$pidfile"

cleanup() {
	rm -f "$tmpbase.out" "$tmpbase.err"
	[ "${LINKSPEED_SHARED:-0}" = "1" ] || rm -f "$pidfile"
}
trap cleanup EXIT INT TERM

curl --location --silent --show-error \
	--connect-timeout 10 --max-time "$duration" \
	$range_arg --output /dev/null \
	--write-out '%{http_code}|%{remote_ip}|%{size_download}|%{speed_download}|%{time_namelookup}|%{time_connect}|%{time_starttransfer}|%{time_total}' \
	--url "$url" >"$tmpbase.out" 2>"$tmpbase.err" &
curl_pid=$!
printf '%s\n%s\n' "$curl_pid" "$$" >> "$pidfile"
wait "$curl_pid"
curl_code=$?
result="$(cat "$tmpbase.out")"

# curl returns 28 when --max-time is reached, but the statistics are still valid.
if [ -n "$result" ]; then
	printf '%s\n' "$result"
	exit 0
fi

echo "curl speed test failed (code $curl_code)" >&2
cat "$tmpbase.err" >&2
exit "$curl_code"
