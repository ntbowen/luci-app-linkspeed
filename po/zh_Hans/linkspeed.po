msgid "Network Speed Test"
msgstr "网络测速"

msgid "Grant access to the selectable link speed test"
msgstr "授权使用可选节点链路测速工具"

msgid "Instant speed test tool; no save & apply needed. Test traffic is generated by the router WAN egress."
msgstr "即时测速工具，无需保存应用。测速流量由路由器 WAN 出口产生。"

msgid "Test Parameters"
msgstr "测速参数"

msgid "Node group"
msgstr "节点组"

msgid "China mainland nodes"
msgstr "中国内地节点"

msgid "Global nodes"
msgstr "海外节点"

msgid "Single node selection"
msgstr "单节点选择"

msgid "Custom temporary link"
msgstr "自定义临时链接"

msgid "Max duration (seconds)"
msgstr "最长时长（秒）"

msgid "Max total traffic per direction (MB)"
msgstr "每方向最大总流量（MB）"

msgid "Enter 0 for unlimited traffic; the test stops when the time limit is reached. A positive value caps the total traffic per direction and is split evenly across the concurrent connections; download and upload are counted separately in duplex mode."
msgstr "填写 0 表示不限制流量，仅按测速时长停止。正数是每个方向的总流量上限，五路并发会平均分配；上下行同时测速会分别计算。"

msgid "History entries to keep"
msgstr "历史最多保留（次）"

msgid "Each completed test counts as one entry, range 1-200; written to storage once finished."
msgstr "每次完整测速算一条，范围 1–200；完成后一次性写入硬盘。"

msgid "Single-node test"
msgstr "单节点测速"

msgid "5-node concurrent test"
msgstr "五节点并发测速"

msgid "3-way upload test"
msgstr "三路上传测速"

msgid "Duplex test (down+up)"
msgstr "上下行同时测速"

msgid "Stop now"
msgstr "立即停止"

msgid "Test History"
msgstr "测速历史"

msgid "Refresh history"
msgstr "刷新历史"

msgid "Click \"Refresh history\" to load saved records."
msgstr "点击“刷新历史”读取已保存记录。"

msgid "No speed test has been run yet."
msgstr "尚未开始测速。"

msgid "Unlimited (stop manually or wait for the time limit)"
msgstr "无限制（需手动停止或等待最长时间结束）"

msgid "A speed test / stress test is about to start."
msgstr "即将开始测速/压力测试。"

msgid "Mode:"
msgstr "模式："

msgid "Max duration: %d seconds"
msgstr "最长时间：%d 秒"

msgid "%d seconds"
msgstr "%d 秒"

msgid "Max traffic per direction:"
msgstr "每方向最大总流量："

msgid "The test will keep using WAN bandwidth and may consume a large amount of metered data. Continue?"
msgstr "测试会持续占用 WAN 带宽，并可能产生大量移动数据。确定继续吗？"

msgid "Waiting for the first sample..."
msgstr "等待第一秒采样……"

msgid "WAN Live Speed (per-second sampling)"
msgstr "WAN 实时速度（每秒采样）"

msgid "Purple: download"
msgstr "紫色：下载"

msgid "Cyan: upload"
msgstr "青色：上传"

msgid "Source: WAN interface byte counters"
msgstr "数据来源：WAN 接口字节计数"

msgid "Each raw point is a 1-second sample; long records are downsampled only when drawing."
msgstr "每个原始点为一秒采样；长记录仅在绘图时自动抽样。"

msgid "Download:"
msgstr "下载："

msgid "Upload:"
msgstr "上传："

msgid "Average:"
msgstr "平均："

msgid "Peak:"
msgstr "峰值："

msgid "Last 600 s max"
msgstr "最近最多 600 秒"

msgid "Speed test job failed"
msgstr "测速任务失败"

msgid "Invalid data format returned by the test program"
msgstr "测速程序返回的数据格式无效"

msgid "Please enter a valid HTTP/HTTPS direct link."
msgstr "请输入有效的 HTTP/HTTPS 直链。"

msgid "Please check the test duration and max download size."
msgstr "请检查测速时长和最大下载量。"

msgid "Please check the test duration and max traffic per direction."
msgstr "请检查测速时长和每方向最大流量。"

msgid "Invalid node count or test parameters."
msgstr "节点数量或测速参数无效。"

msgid "Single-node download"
msgstr "单节点下载"

msgid "5-node concurrent download"
msgstr "五节点并发下载"

msgid "3-way concurrent upload"
msgstr "三路上传"

msgid "Single-node test running; click \"Stop now\" at any time..."
msgstr "单节点测速中，可随时点击“立即停止”……"

msgid "5-node concurrent test running; click \"Stop now\" at any time..."
msgstr "五节点并发测速中，可随时点击“立即停止”……"

msgid "3-way upload test running; click \"Stop now\" at any time..."
msgstr "三路上传测速中，可随时点击“立即停止”……"

msgid "Duplex test running (5 download + 3 upload streams)..."
msgstr "上下行同时测速中（5 路下载 + 3 路上传）……"

msgid "Single-node Result"
msgstr "单节点结果"

msgid "5-node Aggregate Result"
msgstr "五节点聚合结果"

msgid "3-way Upload Result"
msgstr "三路上传结果"

msgid "Duplex Test Result"
msgstr "上下行同时测速结果"

msgid "Downloaded:"
msgstr "下载量："

msgid "Uploaded:"
msgstr "上传量："

msgid "Total downloaded:"
msgstr "总下载量："

msgid "Total uploaded:"
msgstr "总上传量："

msgid "Endpoint:"
msgstr "接收端点："

msgid "Node"
msgstr "节点"

msgid "Speed"
msgstr "速度"

msgid "Time"
msgstr "用时"

msgid "Time limit reached"
msgstr "限时结束"

msgid "Incomplete data returned by the duplex test"
msgstr "双向测速返回数据不完整"

msgid "Simultaneous bidirectional testing reflects link capacity under full load; results are usually lower than separate tests."
msgstr "双向同时测速反映满负载时的链路能力，结果通常低于分开测试。"

msgid "Test failed:"
msgstr "测速失败："

msgid "Concurrent test failed:"
msgstr "并发测速失败："

msgid "Upload test failed:"
msgstr "上传测速失败："

msgid "Duplex test failed:"
msgstr "双向测速失败："

msgid "Stopping test..."
msgstr "正在停止测速……"

msgid "Test stopped; all test connections closed."
msgstr "测速已停止，所有测速连接均已关闭。"

msgid "Stop failed:"
msgstr "停止失败："

msgid "Loading history..."
msgstr "正在读取历史……"

msgid "Failed to load history:"
msgstr "读取历史失败："

msgid "Loading per-second samples..."
msgstr "正在读取秒级打点……"

msgid "This record has no speed samples"
msgstr "该记录没有速度采样点"

msgid "Click the curve to inspect a specific second."
msgstr "点击曲线查看某一秒的实际数据。"

msgid "Avg download:"
msgstr "平均下载："

msgid "Avg upload:"
msgstr "平均上传："

msgid "Peak download:"
msgstr "峰值下载："

msgid "Peak upload:"
msgstr "峰值上传："

msgid "Samples:"
msgstr "采样点："

msgid "Start time"
msgstr "开始时间"

msgid "Mode"
msgstr "模式"

msgid "Duration"
msgstr "时长"

msgid "Samples"
msgstr "采样点"

msgid "Actions"
msgstr "操作"

msgid "View samples"
msgstr "查看打点"

msgid "No test history yet."
msgstr "暂无测速历史。"
